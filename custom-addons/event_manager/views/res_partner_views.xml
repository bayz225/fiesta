<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue pivot personnalisée -->
    <record id="view_partner_custom_pivot" model="ir.ui.view">
        <field name="name">res.partner.pivot.custom</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <pivot string="Analyse Contacts">
                <field name="name" type="row"/>
                <!-- <field name="all_event_list" type="row"/> -->

                <field name="event_count" type="measure"/>
                <field name="total_guests_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Ajouter le mode pivot à l'action native des contacts -->
    <record id="contacts.action_contacts" model="ir.actions.act_window">
        <field name="view_mode" eval="'kanban,list,form,activity,pivot'"/>
    </record>

    <!-- Lier la vue pivot à l'action -->
    <record id="action_partner_pivot_view_link" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_partner_custom_pivot"/>
        <field name="act_window_id" ref="contacts.action_contacts"/>
    </record>
</odoo>