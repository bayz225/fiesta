<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Vue Liste -->
    <record id="view_fiesta_event_list" model="ir.ui.view">
        <field name="name">fiesta.event.list</field>
        <field name="model">fiesta.event</field>
        <field name="arch" type="xml">
            <list string="Événements">
                <field name="name"/>
                <field name="contact_id" widget="many2one_avatar"/>
                <field name="date"/>
                <field name="time" widget="float_time"/>
                <field name="location"/>
                <field name="available_places_char" widget="badge" decoration-success="available_places_int == max_guest" decoration-danger="available_places_int == 0" decoration-warning="available_places_int &lt; max_guest and available_places_int &gt; 0"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-muted="state == 'done'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Copie de la vue Liste pour "Mes invitations" -->
    <record id="view_fiesta_event_invited_list" model="ir.ui.view">
        <field name="name">fiesta.event.invited.list</field>
        <field name="model">fiesta.event</field>
        <field name="inherit_id" ref="event_manager.view_fiesta_event_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">0</attribute>
            </list>
        </field>
    </record>

    <!-- Vue Calendrier -->
    <record id="view_fiesta_event_calendar" model="ir.ui.view">
        <field name="name">fiesta.event.calendar</field>
        <field name="model">fiesta.event</field>
        <field name="arch" type="xml">
            <calendar string="Calendrier des événements" date_start="date" color="contact_id" mode="month">
                <field name="name"/>
                <field name="location"/>
                <field name="available_places_char"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Vue Recherche -->
    <record id="view_fiesta_event_search" model="ir.ui.view">
        <field name="name">fiesta.event.search</field>
        <field name="model">fiesta.event</field>
        <field name="arch" type="xml">
            <search string="Rechercher un événement">
                <field name="name"/>
                <field name="contact_id"/>
                <field name="location"/>
                <filter string="Mes événements" name="my_events" domain="[('contact_id.user_ids', 'in', [uid])]"/>
                <filter string="Invité à des événements" name="invited_to_event" domain="[('guest_ids.user_ids', 'in', [uid])]"/>
                <separator/>
                <filter string="À venir" name="upcoming" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Confirmés" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Complets" name="full" domain="[('available_places_int', '=', 0)]"/>
                <group>
                    <filter string="Organisateur" name="group_organizer" context="{'group_by': 'contact_id'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vue Formulaire -->
    <record id="view_fiesta_event_form" model="ir.ui.view">
        <field name="name">fiesta.event.form</field>
        <field name="model">fiesta.event</field>
        <field name="arch" type="xml">
            <form string="Mon événement">
                <field name="is_done" invisible="1"/>
                <field name="can_add_guest" invisible="1"/>

                <field name="is_owner" invisible="1"/>
                <field name="is_manager" invisible="1"/>

                <header>
                    <button name="action_confirm" type="object" string="Confirmer" class="btn-primary" invisible="(not is_manager and not is_owner) or (state != 'draft')" />
                    <button name="%(action_add_contact_to_event_wizard)d" type="action" string="Inviter des contacts" class="btn-secondary" invisible="(not is_manager and not is_owner) or state in ('cancelled', 'done') or not can_add_guest" />
                    <button name="action_done" type="object" string="Terminer" invisible="(not is_manager and not is_owner) or state != 'confirmed' or not is_done" />
                    <button name="action_cancel" type="object" string="Annuler" invisible="(not is_manager and not is_owner) or state in ('cancelled', 'done')" />
                    <button name="action_reset_draft" type="object" string="Remettre en brouillon" invisible="(not is_manager and not is_owner) or state != 'cancelled'" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de l'événement" readonly="(not is_manager and not is_owner) or state != 'draft'" />
                        </h1>
                        <p>
                            <label for="description" string="Description"/>
                            <field name="description" placeholder="Entrez la description de l'événement" readonly="(not is_manager and not is_owner) or state not in ('draft', 'confirmed')" />
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="contact_id" widget="many2one_avatar" readonly="(not is_manager and not is_owner) or state != 'draft'" />
                            <field name="date" readonly="(not is_manager and not is_owner) or state != 'draft'" />
                            <field name="time" widget="float_time" readonly="(not is_manager and not is_owner) or state != 'draft'" />
                            <field name="location" readonly="(not is_manager and not is_owner) or state != 'draft'" />
                        </group>
                        <group>
                            <field name="party_theme" widget="color_picker" readonly="(not is_manager and not is_owner) or state != 'draft'" />
                            <field name="max_guest" readonly="(not is_manager and not is_owner) or state not in ('draft', 'confirmed')" />
                            <field name="available_places_char" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Invités" name="guest_tab">
                            <field name="invitation_line_ids">
                                <list create="false" delete="true" edit="false" no_open="1">
                                    <field name="guest_id" widget="many2one_avatar" readonly="1"/>
                                    <field name="arrival_time" widget="float_time" placeholder="--:--"/>
                                    <field name="number_of_companions"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Copie de la vue Formulaire pour "Mes invitations" -->
    <record id="view_fiesta_event_invited_form" model="ir.ui.view">
        <field name="name">fiesta.event.invited.form</field>
        <field name="model">fiesta.event</field>
        <field name="inherit_id" ref="event_manager.view_fiesta_event_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <!-- Désactivation de la création -->
            <form position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="write">0</attribute>
            </form>

            <!-- Ajout du bouton dans le header de la vue parente -->
            <xpath expr="//header" position="inside">
                <button name="%(action_add_guest_info_to_event)d" 
                    type="action" 
                    string="Confirmer ma présence" 
                    class="btn-primary" 
                    icon="fa-check" 
                    invisible="state not in ('confirmed')"
                    context="{'default_event_id': id}"
                />
            </xpath>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_fiesta_event_all" model="ir.actions.act_window">
        <field name="name">Tous les événements</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fiesta.event</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier événement !
            </p>
        </field>
    </record>

    <!-- Liaison explicite pour "Tous les événements" -->
    <record id="action_fiesta_event_all_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_fiesta_event_list"/>
        <field name="act_window_id" ref="action_fiesta_event_all"/>
    </record>

    <record id="action_fiesta_event_all_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_fiesta_event_form"/>
        <field name="act_window_id" ref="action_fiesta_event_all"/>
    </record>

    <record id="action_fiesta_event_mine" model="ir.actions.act_window">
        <field name="name">Mes événements</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fiesta.event</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="domain">[('contact_id.user_ids', 'in', [uid])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Vous n'avez encore organisé aucun événement.
            </p>
        </field>
    </record>

    <!-- Liaison explicite de la vue Liste standard (avec bouton Créer) pour "Mes événements" -->
    <record id="action_fiesta_event_mine_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_fiesta_event_list"/>
        <field name="act_window_id" ref="action_fiesta_event_mine"/>
    </record>

    <!-- Liaison explicite de la vue Formulaire standard pour "Mes événements" -->
    <record id="action_fiesta_event_mine_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_fiesta_event_form"/>
        <field name="act_window_id" ref="action_fiesta_event_mine"/>
    </record>

    <record id="action_fiesta_event_invited" model="ir.actions.act_window">
        <field name="name">Mes invitations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fiesta.event</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="domain">[('guest_ids.user_ids', 'in', [uid]), ('state', 'not in', ['draft', 'cancelled'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Vous n'êtes invité à aucun événement pour le moment.
            </p>
        </field>
    </record>

    <!-- Liaison de la vue Liste -->
    <record id="action_fiesta_event_invited_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_fiesta_event_invited_list"/>
        <field name="act_window_id" ref="action_fiesta_event_invited"/>
    </record>

    <!-- Liaison de la vue Formulaire -->
    <record id="action_fiesta_event_invited_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_fiesta_event_invited_form"/>
        <field name="act_window_id" ref="action_fiesta_event_invited"/>
    </record>

    <!-- Menus Événements -->
    <menuitem id="menu_event_all" name="Tous les événements" parent="menu_event_manager_events" action="action_fiesta_event_all" groups="event_manager.group_event_manager" sequence="10"/>

    <menuitem id="menu_event_mine" name="Mes événements" parent="menu_event_manager_events" action="action_fiesta_event_mine" sequence="20"/>

    <menuitem id="menu_event_invited" name="Mes invitations" parent="menu_event_manager_events" action="action_fiesta_event_invited" sequence="30"/>
</odoo>
