<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Stat Button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_contacted_event_manage)d" context="{'default_guest_id': id}" type="action" class="oe_stat_button" icon="fa-file-text-o" string="Mes invitations"/>
            </xpath>

            <!-- Header Button -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="%(action_add_event)d" string="Créer un événement" type="action" class="btn-primary"/>
                </header>
            </xpath>

            <!-- Retrait éventuel de l'autofocus natif -->
            <xpath expr="//notebook/page[@name='contact_addresses']" position="attributes">
                <attribute name="autofocus"></attribute>
            </xpath>

            <!-- Onglet : Mes événements (avec autofocus par défaut) -->
            <xpath expr="//notebook/page[@name='contact_addresses']" position="before">
                <page string="Mes événements" name="contact_events" autofocus="autofocus">
                    <field name="events_organized_ids" readonly="1">
                        <list string="Mes événements" empty="Aucun événement trouvé !" create="false" delete="true" edit="false">
                            <field name="name"/>
                            <field name="date"/>
                            <field name="time" widget="float_time" optional="show"/>
                            <field name="location" optional="show"/>
                            <field name="available_places_char" widget="badge" decoration-success="available_places_int == max_guest" decoration-danger="available_places_int == 0" decoration-warning="available_places_int &lt; max_guest"/>
                            <button name="%(action_add_contact_to_event_wizard)d" type="action" string="Inviter" icon="fa-address-book" class="oe_highlight"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <!-- Onglet : Invitations reçues -->
            <xpath expr="//notebook/page[@name='contact_events']" position="after">
                <page string="Invitations reçues" name="contacted_events">
                    <field name="invitation_ids" readonly="1">
                        <list string="Événements invités" empty="Aucun événement trouvé !" create="false" delete="false" edit="false" no_open="1">
                            <field name="event_id" column_invisible="True"/>
                            <field name="is_expired_confirmation" column_invisible="True"/>
                            <field name="event_name"/>
                            <field name="event_date"/>
                            <field name="event_time" widget="float_time" optional="show"/>
                            <field name="event_location" optional="show"/>
                            <field name="contact_id" widget="many2one_tags_avatar"/>
                            <field name="available_places_char" widget="badge" decoration-success="available_places_int == max_guest" decoration-danger="available_places_int == 0" decoration-warning="available_places_int &lt; max_guest"/>

                            <button name="%(action_add_guest_info_to_event)d" type="action" string="Confirmer ma présence" invisible="is_expired_confirmation" icon="fa-calendar-plus-o" class="oe_highlight" context="{'default_event_id': event_id, 'default_guest_id': parent.id}"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_kanban_inherit" model="ir.ui.view">
        <field name="name">res.partner.kanban.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_ids']" position="before">
                <div class="flex-left" style="background-color: #e9ebecff; color: #000000; padding: 3px 8px; border-radius: 10px; font-size: 13px; display: inline-block;">
                    <field name="event_count"/>
                    <span style="margin-left: 4px;">
                        Invitations
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>