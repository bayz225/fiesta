<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Lecture et création autorisées pour tous les utilisateurs internes -->
        <record id="rule_fiesta_event_read_create_all" model="ir.rule">
            <field name="name">Événement : lecture et création pour tous les utilisateurs internes</field>
            <field name="model_id" ref="model_fiesta_event"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Modification et suppression uniquement par l'organisateur -->
        <record id="rule_fiesta_event_write_unlink_organizer" model="ir.rule">
            <field name="name">Événement : modification et suppression par l'organisateur uniquement</field>
            <field name="model_id" ref="model_fiesta_event"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[('contact_id', '=', user.partner_id.id)]</field>
        </record>
    </data>
</odoo>
