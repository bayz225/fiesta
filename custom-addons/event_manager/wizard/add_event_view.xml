<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_add_event_form" model="ir.ui.view">
        <field name="name">add.event.wizard.form</field>
        <field name="model">add.event.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de l'événement"/>
                        </h1>
                        <p>
                            <label for="description" string="Description"/>
                            <field name="description" placeholder="Entrez la description de l'événement"/>
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="contact_id" readonly="1" widget="many2one_avatar"/>
                            <field name="date"/>
                            <field name="time" widget="float_time"/>
                            <field name="location" placeholder="Entrez le lieu de l'événement"/>
                        </group>
                        <group>
                            <field name="party_theme" widget="color_picker"/>
                            <field name="max_guest"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_add_event" type="object" string="Créer" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_add_event" model="ir.actions.act_window">
        <field name="name">Créer un événement</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">add.event.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_contact_id': active_id}</field>
        <field name="target">new</field>
    </record>
</odoo>