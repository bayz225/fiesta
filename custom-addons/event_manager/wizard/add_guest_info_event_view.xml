<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_add_guest_info_to_event" model="ir.ui.view">
        <field name="name">add.guest.info.to.event.wizard.form</field>
        <field name="model">add.guest.info.to.event.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="event_id" readonly="1"/>
                            <field name="guest_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="arrival_time" widget="float_time"/>
                            <field name="number_of_companions"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_add_guest_info" type="object" string="Enregistrer" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_add_guest_info_to_event" model="ir.actions.act_window">
        <field name="name">Informations d'arrivée</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">add.guest.info.to.event.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>