<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="event_manager.EventDashboard" owl="1">
        <!-- Conteneur principal -->
        <main class="main-content mt-1 border-radius-lg my-custom-dashboard">
            <div class="container-fluid py-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="mb-0 fs-4">Tableau de bord</h2>
                    <button type="button" class="btn btn-primary btn-sm" t-on-click="() => this.openAllEvents()">
                        Voir tous les événements
                    </button>
                </div>
                <!-- Ligne 1 : Cartes de Statistiques -->
                <div class="row">
                    <!-- Carte 1 -->
                    <div class="col-xl-3 col-sm-6 mb-xl-0 mb-4">
                        <div class="card">
                            <div class="card-body p-3">
                                <div class="row">
                                    <div class="col-8">
                                        <div class="numbers">
                                            <p class="mb-0 font-weight-bold">Événements enregistrés</p>
                                            <h5 class="font-weight-bolder mb-0">
                                                <span t-esc="state.count_all_events"/>
                                                <span t-attf-class="text-sm font-weight-bolder ml-1 {{ state.percentage_of_created_events_last_7_days &gt;= 0 ? 'text-success' : 'text-danger'}}">
                                                    <t t-if="state.percentage_of_created_events_last_7_days &gt; 0">+</t>
                                                    <span t-esc="state.percentage_of_created_events_last_7_days"/>
%
                                                </span>
                                            </h5>
                                        </div>
                                    </div>
                                    <div class="col-4 text-end">
                                        <div class="icon icon-shape bg-gradient-primary shadow text-center d-flex align-items-center justify-content-center border-radius-md">
                                            <svg xmlns="http://www.w3.org/2000/svg" height="30px" viewBox="0 -960 960 960" width="30px" fill="#ffffffff">
                                                <path d="M107.69-100q24.39-74 32.35-150.19Q148-326.38 150-403.85q-39-11.92-64.5-47.3Q60-486.54 60-540v-46.15q110.38-36.47 224.88-110.62T480-855.38q80.62 84.46 195.12 158.61Q789.62-622.62 900-586.15V-540q0 53.46-25.5 88.85-25.5 35.38-64.5 47.3 2 77.47 9.96 153.66Q827.92-174 852.31-100H107.69Zm42.16-480h660.3q-93.38-40.92-176.27-97.42Q551-733.92 480-799.69q-71 65.77-153.88 122.27-82.89 56.5-176.27 97.42ZM580-440q36.54 0 58.27-30.19Q660-500.38 660-540H500q0 39.62 21.73 69.81Q543.46-440 580-440Zm-200 0q36.54 0 58.27-30.19Q460-500.38 460-540H300q0 39.62 21.73 69.81Q343.46-440 380-440Zm-200 0q36.54 0 58.27-30.19Q260-500.38 260-540H100q0 39.62 21.73 69.81Q143.46-440 180-440Zm-20.15 300h150.84q10.54-67.69 15.93-134.77 5.38-67.08 7.61-135.54-15.92-7.31-29.92-19.73-14-12.42-24.31-31.96-14.23 26.54-37.5 42.58T190-400.69q-2 66.23-7.77 131.34-5.77 65.12-22.38 129.35Zm191.07 0h258.16q-10.31-65-15.58-129.62-5.27-64.61-7.5-130.61-33.69 1.85-62.5-15.58-28.81-17.42-43.5-49.04-14.69 31.62-43.73 49.04-29.04 17.43-62.27 15.58-2.23 66-7.5 130.61Q361.23-205 350.92-140Zm298.39 0h150.84q-16.61-64.23-22.38-129.35Q772-334.46 770-400.69q-29.23-2.69-53.38-18.73-24.16-16.04-36.62-44.12-8.77 20.31-23.54 33.12-14.77 12.8-30.69 20.11 2.23 68.46 7.73 135.54T649.31-140ZM780-440q36.54 0 58.27-30.19Q860-500.38 860-540H700q0 39.62 21.73 69.81Q743.46-440 780-440Z"/>
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Carte 2 -->
                    <div class="col-xl-3 col-sm-6 mb-xl-0 mb-4">
                        <div class="card">
                            <div class="card-body p-3">
                                <div class="row">
                                    <div class="col-8">
                                        <div class="numbers">
                                            <p class="mb-0 font-weight-bold">Événements de ce mois</p>
                                            <h5 class="font-weight-bolder mb-0">
                                                <span t-esc="state.count_events_of_this_month"/>
                                                <span t-attf-class="text-sm font-weight-bolder ml-2 {{state.percentage_of_events_this_month &gt;= 0 ? 'text-success' : 'text-danger'}}">
                                                    <t t-if="state.percentage_of_events_this_month &gt; 0">+</t>
                                                    <span t-esc="state.percentage_of_events_this_month"/>
%
                                                </span>
                                            </h5>
                                        </div>
                                    </div>
                                    <div class="col-4 text-end">
                                        <div class="icon icon-shape bg-gradient-primary shadow d-flex align-items-center justify-content-center text-center border-radius-md">
                                            <svg xmlns="http://www.w3.org/2000/svg" height="30px" viewBox="0 -960 960 960" width="30px" fill="#ffffffff">
                                                <path d="M716.92-460v-40h129.23v40H716.92Zm43.39 258.46-103.39-77.54 24.93-31.69 103.38 77.54-24.92 31.69Zm-81.54-450.77L653.85-684l103.38-77.54 24.92 31.69-103.38 77.54ZM220-241.54v-152.31h-41.54q-26.84 0-45.73-18.88-18.88-18.89-18.88-45.73v-43.08q0-26.84 18.88-45.73 18.89-18.88 45.73-18.88h149.23L486.15-660v360l-158.46-93.85H260v152.31h-40Zm226.15-129.69v-217.54l-107.23 62.62H178.46q-9.23 0-16.92 7.69-7.69 7.69-7.69 16.92v43.08q0 9.23 7.69 16.92 7.69 7.69 16.92 7.69h160.46l107.23 62.62Zm110.77 6.77v-231.08q20.08 18.62 32.35 48.89 12.27 30.27 12.27 66.65 0 36.38-12.27 66.65-12.27 30.27-32.35 48.89ZM300-480Z"/>
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Carte 3 -->
                    <div class="col-xl-3 col-sm-6 mb-xl-0 mb-4">
                        <div class="card">
                            <div class="card-body p-3">
                                <div class="row">
                                    <div class="col-8">
                                        <div class="numbers">
                                            <p class="mb-0 font-weight-bold">Événements à venir</p>
                                            <h5 t-attf-class="font-weight-bolder mb-0 {{state.count_upcoming_events &lt; 0 ? 'text-danger' : ''}}">
                                                <span t-esc="state.count_upcoming_events"/>
                                            </h5>
                                        </div>
                                    </div>
                                    <div class="col-4 text-end">
                                        <div class="icon icon-shape bg-gradient-primary shadow d-flex align-items-center justify-content-center text-center border-radius-md">
                                            <svg xmlns="http://www.w3.org/2000/svg" height="30px" viewBox="0 -960 960 960" width="30px" fill="#ffffffff">
                                                <path d="M224.62-120q-27.62 0-46.12-18.5Q160-157 160-184.62v-510.76q0-27.62 18.5-46.12Q197-760 224.62-760h70.76v-89.23h43.08V-760h286.16v-89.23h40V-760h70.76q27.62 0 46.12 18.5Q800-723 800-695.38v263.46l-40 40v-143.46H200v350.76q0 9.24 7.69 16.93 7.69 7.69 16.93 7.69h238l40.76 40H224.62ZM200-575.39h560v-119.99q0-9.24-7.69-16.93-7.69-7.69-16.93-7.69H224.62q-9.24 0-16.93 7.69-7.69 7.69-7.69 16.93v119.99Zm0 0V-720-575.39ZM658.92-100 549.23-208.92l28.31-28.31 81.15 81.15L821-318.38l28.31 28.53L658.92-100Z"/>
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Carte 4 -->
                    <div class="col-xl-3 col-sm-6">
                        <div class="card">
                            <div class="card-body p-3">
                                <div class="row">
                                    <div class="col-8">
                                        <div class="numbers">
                                            <p class="mb-0 font-weight-bold">Taux de remplissage</p>
                                            <h5 t-attf-class="font-weight-bolder mb-0 {{state.percentage_of_events_fully_booked &lt;= 0 ? 'text-danger' : ''}}">
                                                <t t-if="state.percentage_of_events_fully_booked &gt; 0">+</t>
                                                <span t-esc="state.percentage_of_events_fully_booked"/>
%
                                            </h5>
                                        </div>
                                    </div>
                                    <div class="col-4 text-end">
                                        <div class="icon icon-shape bg-gradient-primary shadow d-flex align-items-center justify-content-center text-center border-radius-md">
                                            <svg xmlns="http://www.w3.org/2000/svg" height="30px" viewBox="0 -960 960 960" width="30px" fill="#ffffffff">
                                                <path d="M143.85-352.31v-65.84q0-27.85 14.42-47.89t38.76-32.03q52.05-24.78 103.35-39.51 51.31-14.73 123.47-14.73 43.46 0 79 5.85 35.53 5.84 68 16.23-8 7.13-14.58 15.52-6.58 8.4-12.19 16.63-26.93-7.23-56.54-10.73-29.62-3.5-63.69-3.5-63.7 0-113.31 12.73-49.62 12.73-94.39 36.66-18.23 9.61-25.27 20.15-7.03 10.54-7.03 24.62v25.84H503q-1.23 9.75-1.23 19.49 0 9.74.46 20.51H143.85Zm280-40Zm-84.93-284.31q-35.07-35.07-35.07-84.92 0-49.84 35.07-84.92 35.08-35.08 84.93-35.08 49.84 0 84.92 35.08t35.08 84.92q0 49.85-35.08 84.92-35.08 35.08-84.92 35.08-49.85 0-84.93-35.08Zm141.43-28.42q23.5-23.5 23.5-56.5t-23.5-56.5q-23.5-23.5-56.5-23.5t-56.5 23.5q-23.5 23.5-23.5 56.5t23.5 56.5q23.5 23.5 56.5 23.5t56.5-23.5Zm-56.5-56.5Zm255.52 84.92q-35.25 35.08-84.75 35.08-2.54 0-6.47-.58-3.92-.57-6.46-1.26 21.62-25.08 31.89-55.38 10.27-30.29 10.27-62.92t-11.04-62.4q-11.04-29.77-31.12-55.61 3.23-1.16 6.46-1.5 3.23-.35 6.47-.35 49.5 0 84.75 35.08t35.25 84.92q0 49.85-35.25 84.92Zm64.25 454.31q-67.26 0-114.67-47.41-47.41-47.4-47.41-114.67 0-68.07 47.41-115.69 47.41-47.61 114.67-47.61 68.07 0 115.69 47.61 47.61 47.62 47.61 115.69 0 67.27-47.61 114.67-47.62 47.41-115.69 47.41Zm-23.16-64.61 111.77-112L810.38-420l-89.92 89.15L675-376.31l-21.85 22.08 67.31 67.31Z"/>
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Ligne 2 : Table des événements récents & Évolution des événements -->
                <div class="row mt-4">
                    <!-- Table des événements récents -->
                    <div class="col-lg-8 mb-lg-0 mb-4">
                        <div class="card">
                            <div class="card-header pb-0 p-3">
                                <h4 class="mb-2 fs-5">Événements Récents</h4>
                                <p class="text-sm mb-2 text-muted">Liste de 10 dernières activités enregistrés</p>
                            </div>
                            <div class="table-responsive">
                                <table class="table align-items-center mb-0">
                                    <thead>
                                        <tr>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-3">Événement</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Organisateur</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Lieu</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Date</th>
                                            <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Disponibilité</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="state.list_of_last_created_events.length">
                                            <t t-foreach="state.list_of_last_created_events" t-as="event" t-key="event.id">
                                                <tr t-on-click="() => this.openEvent(event.id)" style="cursor: pointer;">
                                                    <td>
                                                        <span class="text-xs px-2 font-weight-bold mb-0" t-esc="event.name"/>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex">
                                                            <!-- On vérifie si event.organizer contient des données (s'il n'est pas false) -->
                                                            <div t-if="event.organizer">
                                                                <!-- event.organizer[0] contient l'ID -->
                                                                <img t-attf-src="/web/image?model=res.partner&amp;id={{ event.organizer[0] }}&amp;field=avatar_128" class="avatar avatar-sm rounded-circle me-2" t-att-alt="event.organizer[1]"/>
                                                            </div>
                                                            <div t-else="">
                                                                <!-- Image par défaut si aucun organisateur n'est renseigné -->
                                                                <img src="/event_manager/static/src/img/default_avatar.png" class="avatar avatar-sm rounded-circle me-2" alt="Aucun organisateur"/>
                                                            </div>
                                                            <div class="my-auto">
                                                                <!-- event.organizer[1] contient le Nom -->
                                                                <h6 class="mb-0 text-xs" t-esc="event.organizer ? event.organizer[1] : 'Non défini'"/>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <p class="text-xs font-weight-bold mb-0" t-esc="event.location"/>
                                                    </td>
                                                    <td>
                                                        <span class="text-xs font-weight-bold mb-0" t-esc="event.date"/>
                                                    </td>
                                                    <td class="align-middle text-center">
                                                        <div class="d-flex flex-column align-items-start justify-content-center">
                                                            <span class="me-2 text-md font-weight-bold">
                                                                <t t-esc="event.available_places_percentage"/>
%
                                                            </span>
                                                            <div>
                                                                <div class="progress">
                                                                    <div class="progress-bar bg-info" role="progressbar" t-att-aria-valuenow="event.available_places_percentage" aria-valuemin="0" aria-valuemax="100" t-attf-style="width: {{event.available_places_percentage}}%"></div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <tr>
                                                <td colspan="5" class="text-center">
                                                    <span class="text-xs px-2 font-weight-bold mb-0">Aucun événement trouvé</span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Évolution des événements -->
                    <div class="col-lg-4 mb-lg-0 mb-4">
                        <div class="card mb-3">
                            <div class="card-header pb-0 p-3">
                                <h4 class="mb-2 fs-5">Évolution des événements</h4>
                                <p class="text-sm mb-2 text-muted">Évolution des événements sur les 6 derniers mois</p>
                            </div>
                            <div class="card-body p-3">
                                <div class="chart">
                                    <!-- Ajout de t-ref="chartCanvas" -->
                                    <canvas t-ref="chartCanvas" class="chart-canvas" height="250"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Ligne 3 : Analyse de l'évolution -->
                        <div class="card">

                            <!-- Card Header -->
                            <div class="card-header pb-0 p-3">
                                <h4 class="mb-1 fs-5">
                                    Analyse de l'évolution
                                </h4>

                                <p class="text-sm mb-0 text-muted">
                                    Analyse des 6 derniers mois
                                </p>
                            </div>

                            <!-- Card Body -->
                            <div class="card-body p-3">

                                <!-- Période la plus active -->
                                <div class="d-flex align-items-center mb-2">

                                    <div class="icon icon-shape bg-gradient-primary shadow text-center border-radius-md d-flex align-items-center justify-content-center">

                                        <svg xmlns="http://www.w3.org/2000/svg" height="22px" viewBox="0 -960 960 960" width="22px" fill="#ffffff">

                                            <path d="M180-120q-24.75 0-42.38-17.62Q120-155.25 120-180v-600q0-24.75 17.62-42.38Q155.25-840 180-840h60v-80h60v80h360v-80h60v80h60q24.75 0 42.38 17.62Q840-804.75 840-780v600q0 24.75-17.62 42.38Q804.75-120 780-120H180Zm0-60h600v-420H180v420Zm0-480h600v-120H180v120Zm300 300q-24.75 0-42.38-17.62Q420-395.25 420-420t17.62-42.38Q455.25-480 480-480t42.38 17.62Q540-444.75 540-420t-17.62 42.38Q504.75-360 480-360Z"/>

                                        </svg>

                                    </div>

                                    <div class="ms-3">

                                        <p class="text-sm text-uppercase font-weight-bold mb-0">
                                            Période la plus active
                                        </p>

                                        <h6 class="mb-0 mt-1 text-xs text-uppercase text-success font-weight-bold">
                                            <t t-esc="state.max_guest_period['label']"/>
                                        </h6>

                                        <p class="text-xs text-secondary mb-0">
                                            <t t-esc="state.max_guest_period['guest_count']"/>
 invités
                                        </p>

                                    </div>

                                </div>

                                <!-- Maximum d'événements -->
                                <div class="d-flex align-items-center mb-2">

                                    <div class="icon icon-shape bg-gradient-success shadow text-center border-radius-md d-flex align-items-center justify-content-center">

                                        <svg xmlns="http://www.w3.org/2000/svg" height="22px" viewBox="0 -960 960 960" width="22px" fill="#ffffff">

                                            <path d="m216-240-56-56 296-296 160 160 144-144v96h80v-232H608v80h96L616-544 456-704 216-464l-96-96-56 56 152 152 240-240 160 160 200-200v96h80v-232H608v80h96L616-464 456-624 216-384l-96-96-56 56 152 152Z"/>

                                        </svg>

                                    </div>

                                    <div class="ms-3">

                                        <p class="text-sm text-uppercase font-weight-bold mb-0">
                                            Avec le max d'événements
                                        </p>

                                        <h6 class="mb-0">
                                            <t t-esc="state.max_period['count']"/>
 événements
                                        </h6>

                                        <p class="text-xs text-secondary mb-0">
                                            <t t-esc="state.max_period['label']"/>
                                        </p>

                                    </div>

                                </div>

                                <!-- Minimum d'événements -->
                                <div class="d-flex align-items-center mb-2">

                                    <div class="icon icon-shape bg-gradient-danger shadow text-center border-radius-md d-flex align-items-center justify-content-center">

                                        <svg xmlns="http://www.w3.org/2000/svg" height="22px" viewBox="0 -960 960 960" width="22px" fill="#ffffff">

                                            <path d="M120-120v-720h720v720H120Zm80-80h560v-560H200v560Zm80-80h80v-80h-80v80Zm160 0h80v-200h-80v200Zm160 0h80v-320h-80v320Z"/>

                                        </svg>

                                    </div>

                                    <div class="ms-3">

                                        <p class="text-sm text-uppercase font-weight-bold mb-0">
                                            Avec le min d'événements
                                        </p>

                                        <h6 class="mb-0">
                                            <t t-esc="state.min_period['count']"/>
 événements
                                        </h6>

                                        <p class="text-xs text-secondary mb-0">
                                            <t t-esc="state.min_period['label']"/>
                                        </p>

                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </main>
    </t>
</templates>